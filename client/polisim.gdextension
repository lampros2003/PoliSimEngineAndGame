[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libpolisim_godot.so"
linux.release.x86_64 = "res://bin/libpolisim_godot.so"
windows.debug.x86_64 = "res://bin/polisim_godot.dll"
windows.release.x86_64 = "res://bin/polisim_godot.dll"
